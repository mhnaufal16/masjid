<!-- ARTIKEL LIST -->
<div class="page-header">
  <div>
    <h1 class="page-title">Kelola Artikel</h1>
    <p class="page-subtitle">Tulis dan kelola artikel / berita yang ditampilkan di landing page</p>
  </div>
  <div class="page-actions">
    <a href="/admin/artikel/tambah" class="btn btn-primary-admin">
      <i class="fas fa-plus"></i> Tulis Artikel
    </a>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">
      <i class="fas fa-newspaper" style="color:var(--warning)"></i>
      Semua Artikel (<%= artikel.length %>)
    </div>
    <input type="text" id="table-search" placeholder="🔍 Cari artikel..." style="padding:7px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:0.82rem;width:220px;outline:none">
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Gambar</th>
          <th>Judul</th>
          <th>Kategori</th>
          <th>Penulis</th>
          <th>Status</th>
          <th>Tanggal</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (artikel.length > 0) { %>
          <% artikel.forEach(a => { %>
          <tr>
            <td>
              <% if (a.gambar) { %>
                <img src="<%= a.gambar %>" alt="" class="table-img">
              <% } else { %>
                <div class="table-img" style="display:flex;align-items:center;justify-content:center;font-size:1.25rem;background:var(--bg)">📰</div>
              <% } %>
            </td>
            <td>
              <div style="font-weight:600;font-size:0.875rem"><%= a.judul %></div>
              <div style="font-size:0.78rem;color:var(--text-muted);margin-top:2px">/<%= a.slug %></div>
            </td>
            <td><span class="badge badge-info"><%= a.kategori %></span></td>
            <td style="font-size:0.82rem"><%= a.penulis %></td>
            <td>
              <span class="badge badge-<%= a.aktif ? 'success' : 'warning' %>">
                <%= a.aktif ? '✓ Publik' : '⏸ Draft' %>
              </span>
            </td>
            <td style="font-size:0.78rem;color:var(--text-muted)">
              <%= new Date(a.created_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric'}) %>
            </td>
            <td>
              <div style="display:flex;gap:0.5rem">
                <a href="/artikel/<%= a.slug %>" target="_blank" class="btn btn-secondary btn-sm">
                  <i class="fas fa-eye"></i>
                </a>
                <a href="/admin/artikel/<%= a.id %>/edit" class="btn btn-secondary btn-sm">
                  <i class="fas fa-edit"></i>
                </a>
                <form action="/admin/artikel/<%= a.id %>?_method=DELETE" method="POST" id="del-artikel-<%= a.id %>">
                  <button type="button" class="btn btn-danger btn-sm" data-delete-btn data-name="<%= a.judul %>" data-form-id="del-artikel-<%= a.id %>">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align:center;padding:2rem;color:var(--text-muted)">
              <div style="font-size:2rem;margin-bottom:0.5rem">📰</div>
              Belum ada artikel. <a href="/admin/artikel/tambah" style="color:var(--primary)">Tulis sekarang</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
