<!-- KEGIATAN LIST -->
<div class="page-header">
  <div>
    <h1 class="page-title">Kelola Kegiatan</h1>
    <p class="page-subtitle">Tambah dan kelola kegiatan yang ditampilkan di landing page</p>
  </div>
  <div class="page-actions">
    <a href="/admin/kegiatan/tambah" class="btn btn-primary-admin">
      <i class="fas fa-plus"></i> Tambah Kegiatan
    </a>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">
      <i class="fas fa-calendar-alt" style="color:var(--primary)"></i>
      Daftar Kegiatan (<%= kegiatan.length %>)
    </div>
    <input type="text" id="table-search" placeholder="🔍 Cari kegiatan..." style="padding:7px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:0.82rem;width:220px;outline:none">
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Gambar</th>
          <th>Judul</th>
          <th>Kategori</th>
          <th>Jadwal</th>
          <th>Status</th>
          <th>Urutan</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (kegiatan.length > 0) { %>
          <% kegiatan.forEach(k => { %>
          <tr>
            <td>
              <% if (k.gambar) { %>
                <img src="<%= k.gambar %>" alt="" class="table-img">
              <% } else { %>
                <div class="table-img" style="display:flex;align-items:center;justify-content:center;font-size:1.25rem;background:var(--bg)">🕌</div>
              <% } %>
            </td>
            <td>
              <div style="font-weight:600;font-size:0.875rem"><%= k.judul %></div>
              <div style="font-size:0.78rem;color:var(--text-muted);margin-top:2px"><i class="fas fa-map-marker-alt"></i> <%= k.lokasi %></div>
            </td>
            <td><span class="badge badge-primary"><%= k.kategori %></span></td>
            <td style="font-size:0.82rem">
              <div><i class="fas fa-calendar-week"></i> <%= k.tanggal %></div>
              <div><i class="fas fa-clock"></i> <%= k.waktu %></div>
            </td>
            <td>
              <span class="badge badge-<%= k.aktif ? 'success' : 'danger' %>">
                <%= k.aktif ? '✓ Aktif' : '✗ Nonaktif' %>
              </span>
            </td>
            <td style="text-align:center"><%= k.urutan %></td>
            <td>
              <div style="display:flex;gap:0.5rem">
                <a href="/admin/kegiatan/<%= k.id %>/edit" class="btn btn-secondary btn-sm">
                  <i class="fas fa-edit"></i>
                </a>
                <form action="/admin/kegiatan/<%= k.id %>?_method=DELETE" method="POST" id="del-kegiatan-<%= k.id %>">
                  <button type="button" class="btn btn-danger btn-sm" data-delete-btn data-name="<%= k.judul %>" data-form-id="del-kegiatan-<%= k.id %>">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align:center;padding:2rem;color:var(--text-muted)">
              <div style="font-size:2rem;margin-bottom:0.5rem">📅</div>
              Belum ada kegiatan. <a href="/admin/kegiatan/tambah" style="color:var(--primary)">Tambah sekarang</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
