<!-- DASHBOARD -->
<div class="page-header">
  <div>
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Selamat datang kembali, <%= user ? user.name : 'Admin' %>! Berikut ringkasan konten website.</p>
  </div>
  <div class="page-actions">
    <a href="/" target="_blank" class="btn btn-secondary">
      <i class="fas fa-external-link-alt"></i> Preview Website
    </a>
  </div>
</div>

<!-- STATS -->
<div class="stats-grid">
  <div class="stat-card" style="--card-color:#1a5c38;--card-bg:rgba(26,92,56,0.08)">
    <div class="stat-icon"><i class="fas fa-calendar-alt"></i></div>
    <div>
      <div class="stat-value"><%= stats.kegiatan %></div>
      <div class="stat-label">Total Kegiatan</div>
    </div>
  </div>
  <div class="stat-card" style="--card-color:#3b82f6;--card-bg:rgba(59,130,246,0.08)">
    <div class="stat-icon"><i class="fas fa-images"></i></div>
    <div>
      <div class="stat-value"><%= stats.galeri %></div>
      <div class="stat-label">Foto Galeri</div>
    </div>
  </div>
  <div class="stat-card" style="--card-color:#f59e0b;--card-bg:rgba(245,158,11,0.08)">
    <div class="stat-icon"><i class="fas fa-newspaper"></i></div>
    <div>
      <div class="stat-value"><%= stats.artikel %></div>
      <div class="stat-label">Artikel</div>
    </div>
  </div>
  <div class="stat-card" style="--card-color:#ef4444;--card-bg:rgba(239,68,68,0.08)">
    <div class="stat-icon"><i class="fas fa-hand-holding-heart"></i></div>
    <div>
      <div class="stat-value"><%= stats.donasi %></div>
      <div class="stat-label">Rekening Donasi</div>
    </div>
  </div>
</div>

<!-- CONTENT GRID -->
<div class="dashboard-grid">
  <div>
    <!-- RECENT ARTIKEL -->
    <div class="card" style="margin-bottom:1.5rem">
      <div class="card-header">
        <div class="card-title">
          <i class="fas fa-newspaper" style="color:var(--primary)"></i>
          Artikel Terbaru
        </div>
        <a href="/admin/artikel/tambah" class="btn btn-primary-admin btn-sm">
          <i class="fas fa-plus"></i> Tambah
        </a>
      </div>
      <div class="card-body" style="padding:0.75rem 1.5rem">
        <% if (artikelTerbaru.length > 0) { %>
          <div class="recent-list">
            <% artikelTerbaru.forEach(a => { %>
              <div class="recent-item">
                <% if (a.gambar) { %>
                  <img src="<%= a.gambar %>" alt="" class="recent-img">
                <% } else { %>
                  <div class="recent-img" style="display:flex;align-items:center;justify-content:center;background:var(--bg);border-radius:8px;font-size:1.25rem">📰</div>
                <% } %>
                <div class="recent-info">
                  <div class="recent-title"><%= a.judul %></div>
                  <div class="recent-meta"><%= a.penulis %> · <span class="badge badge-<%= a.aktif ? 'success' : 'danger' %>"><%= a.aktif ? 'Aktif' : 'Draft' %></span></div>
                </div>
                <a href="/admin/artikel/<%= a.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p style="color:var(--text-muted);font-size:0.875rem;padding:1rem 0;text-align:center">Belum ada artikel. <a href="/admin/artikel/tambah" style="color:var(--primary)">Tambah sekarang</a></p>
        <% } %>
      </div>
    </div>

    <!-- RECENT GALERI -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <i class="fas fa-images" style="color:var(--info)"></i>
          Galeri Terbaru
        </div>
        <a href="/admin/galeri" class="btn btn-secondary btn-sm">Kelola</a>
      </div>
      <div class="card-body">
        <% if (galeriTerbaru.length > 0) { %>
          <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:0.5rem">
            <% galeriTerbaru.forEach(g => { %>
              <div style="aspect-ratio:1;border-radius:8px;overflow:hidden;background:var(--bg)">
                <% if (g.gambar) { %>
                  <img src="<%= g.gambar %>" alt="" style="width:100%;height:100%;object-fit:cover">
                <% } else { %>
                  <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:1.5rem">📸</div>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p style="color:var(--text-muted);font-size:0.875rem;text-align:center;padding:1rem 0">Belum ada foto galeri.</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- QUICK ACTIONS -->
  <div>
    <div class="card" style="margin-bottom:1.5rem">
      <div class="card-header">
        <div class="card-title">
          <i class="fas fa-bolt" style="color:var(--warning)"></i>
          Aksi Cepat
        </div>
      </div>
      <div class="card-body">
        <div class="quick-actions">
          <a href="/admin/pengaturan" class="quick-action-btn">
            <span class="quick-action-icon">⚙️</span>
            <span>Edit Profil Masjid</span>
          </a>
          <a href="/admin/kegiatan/tambah" class="quick-action-btn">
            <span class="quick-action-icon">📅</span>
            <span>Tambah Kegiatan</span>
          </a>
          <a href="/admin/galeri" class="quick-action-btn">
            <span class="quick-action-icon">🖼️</span>
            <span>Upload Foto</span>
          </a>
          <a href="/admin/artikel/tambah" class="quick-action-btn">
            <span class="quick-action-icon">📰</span>
            <span>Tulis Artikel</span>
          </a>
          <a href="/admin/jadwal-sholat" class="quick-action-btn">
            <span class="quick-action-icon">🕐</span>
            <span>Update Jadwal</span>
          </a>
          <a href="/admin/donasi" class="quick-action-btn">
            <span class="quick-action-icon">💳</span>
            <span>Kelola Donasi</span>
          </a>
        </div>
      </div>
    </div>

    <!-- INFO ADMIN -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <i class="fas fa-info-circle" style="color:var(--info)"></i>
          Info Sistem
        </div>
      </div>
      <div class="card-body">
        <div style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.875rem">
          <div style="display:flex;justify-content:space-between">
            <span style="color:var(--text-muted)">Versi</span>
            <span style="font-weight:600">1.0.0</span>
          </div>
          <div style="display:flex;justify-content:space-between">
            <span style="color:var(--text-muted)">Database</span>
            <span style="font-weight:600">SQLite</span>
          </div>
          <div style="display:flex;justify-content:space-between">
            <span style="color:var(--text-muted)">Backend</span>
            <span style="font-weight:600">Node.js + Express</span>
          </div>
          <div style="display:flex;justify-content:space-between">
            <span style="color:var(--text-muted)">Status</span>
            <span class="badge badge-success">🟢 Online</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
