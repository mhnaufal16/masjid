<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= artikel.ringkasan %>">
  <meta name="keywords" content="<%= artikel.kategori %>, masjid, islam, <%= settings.masjid_nama %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= artikel.ringkasan %>">
  <meta property="og:image" content="<%= artikel.gambar %>">
  <meta property="og:type" content="article">
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
  
  <!-- Premium Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    .article-header { padding: 130px 0 50px; background: var(--emerald-gradient-bg); text-align: center; color: white; position: relative; border-bottom: 1px solid var(--gold-border); }
    .article-title { font-size: clamp(2rem, 3.5vw, 3rem); color: var(--white); margin-bottom: 1.25rem; max-width: 850px; margin-left: auto; margin-right: auto; line-height: 1.35; font-family: 'Cinzel', serif; }
    .article-meta { display: flex; align-items: center; justify-content: center; gap: 1.5rem; color: var(--gold-light); font-size: 0.95rem; margin-bottom: 2rem; font-weight: 500; }
    .article-meta-item { display: flex; align-items: center; gap: 0.5rem; }
    .article-img-wrap { max-width: 920px; margin: -50px auto 40px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); position: relative; z-index: 2; border: 3px solid var(--white); }
    .article-img-wrap img { width: 100%; height: auto; display: block; aspect-ratio: 16/9; object-fit: cover; }
    .article-body { max-width: 820px; margin: 40px auto 60px; padding: 0 20px; font-size: 1.1rem; line-height: 1.85; color: var(--text-dark); }
    .article-body p { margin-bottom: 1.75rem; }
    .article-body img { max-width: 100%; border-radius: 14px; margin: 2rem 0; box-shadow: var(--shadow-md); }
    .article-body h2, .article-body h3 { color: var(--emerald-950); margin: 2.5rem 0 1rem; font-family: 'Cinzel', serif; font-weight: 800; }
    .related-articles { background: var(--off-white); padding: 70px 0; border-top: 1px solid var(--gray-200); }
  </style>
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar">
  <div class="nav-container">
    <a href="/" class="nav-brand">
      <% if (settings.masjid_logo && settings.masjid_logo !== '/images/logo-masjid.png') { %>
        <img src="<%= settings.masjid_logo %>" alt="Logo <%= settings.masjid_nama %>" class="nav-logo">
      <% } else { %>
        <div class="nav-logo-badge">
          <span>🕌</span>
        </div>
      <% } %>
      <div class="nav-brand-text">
        <div class="brand-label">Masjid Agung</div>
        <div class="brand-name"><%= settings.masjid_nama %></div>
        <div class="brand-tagline"><%= settings.masjid_slogan %></div>
      </div>
    </a>

    <ul class="nav-menu" id="nav-menu">
      <% navMenu.forEach(menu => { %>
        <li><a href="<%= menu.url.startsWith('#') ? '/' + menu.url : menu.url %>"><%= menu.label %></a></li>
      <% }) %>
      <li>
        <a href="/#donasi" class="btn-donasi">
          <i class="fas fa-hand-holding-heart"></i>
          <span>Donasi Sekarang</span>
        </a>
      </li>
    </ul>

    <button class="nav-mobile-btn" id="nav-mobile-btn" aria-label="Menu">
      <span class="hamburger-icon">☰</span>
    </button>
  </div>
</nav>

<!-- HEADER -->
<header class="article-header">
  <div class="section-container">
    <div class="section-badge badge-gold" style="margin-bottom: 1.25rem;"><%= artikel.kategori %></div>
    <h1 class="article-title"><%= artikel.judul %></h1>
    <div class="article-meta">
      <div class="article-meta-item"><i class="far fa-calendar-alt"></i> <%= artikel.created_at.split(' ')[0] %></div>
      <div class="article-meta-item"><i class="far fa-user"></i> Penulis: <%= artikel.penulis || 'Admin' %></div>
    </div>
  </div>
</header>

<!-- FEATURED IMAGE -->
<% if (artikel.gambar) { %>
<div class="section-container">
  <div class="article-img-wrap fade-in">
    <img src="<%= artikel.gambar %>" alt="<%= artikel.judul %>">
  </div>
</div>
<% } %>

<!-- CONTENT -->
<article class="article-body">
  <%- artikel.konten %>
  
  <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--gray-200); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <div>
      <span style="font-weight: 700; color: var(--emerald-950); margin-right: 1rem;">Bagikan:</span>
      <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(title + ' - ' + settings.masjid_nama) %>" target="_blank" class="sosmed-btn" style="background:#25d366;color:white"><i class="fab fa-whatsapp"></i> WhatsApp</a>
      <a href="https://www.facebook.com/sharer/sharer.php?u=#" target="_blank" class="sosmed-btn fb" style="color:white"><i class="fab fa-facebook-f"></i> Facebook</a>
    </div>
    <a href="/#artikel" class="btn-primary" style="padding:10px 22px;font-size:0.88rem">
      <i class="fas fa-arrow-left"></i> Kembali ke Beranda
    </a>
  </div>
</article>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-top-accent"></div>
  <div class="section-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="nav-brand" style="margin-bottom:1rem">
          <div class="nav-logo-badge">
            <span>🕌</span>
          </div>
          <div class="nav-brand-text">
            <div class="brand-label" style="color:var(--gold-accent)">Masjid Agung</div>
            <div class="brand-name" style="color:#ffffff"><%= settings.masjid_nama %></div>
            <div class="brand-tagline"><%= settings.masjid_slogan %></div>
          </div>
        </div>
        <p class="footer-desc"><%= settings.footer_deskripsi %></p>
        <div class="sosmed-links">
          <% if (settings.sosmed_facebook) { %>
            <a href="<%= settings.sosmed_facebook %>" target="_blank" class="sosmed-btn fb" style="padding:8px 12px"><i class="fab fa-facebook-f"></i></a>
          <% } %>
          <% if (settings.sosmed_instagram) { %>
            <a href="<%= settings.sosmed_instagram %>" target="_blank" class="sosmed-btn ig" style="padding:8px 12px"><i class="fab fa-instagram"></i></a>
          <% } %>
          <% if (settings.sosmed_youtube) { %>
            <a href="<%= settings.sosmed_youtube %>" target="_blank" class="sosmed-btn yt" style="padding:8px 12px"><i class="fab fa-youtube"></i></a>
          <% } %>
        </div>
      </div>

      <div class="footer-col">
        <h4>Navigasi</h4>
        <div class="footer-links">
          <% navMenu.slice(0, 6).forEach(menu => { %>
            <a href="<%= menu.url.startsWith('#') ? '/' + menu.url : menu.url %>"><i class="fas fa-chevron-right" style="font-size:0.6rem;color:var(--gold-accent)"></i> <%= menu.label %></a>
          <% }) %>
        </div>
      </div>

      <div class="footer-col">
        <h4>Kontak Resmi</h4>
        <div class="footer-links">
          <a href="/#kontak"><i class="fas fa-map-marker-alt" style="color:var(--gold-accent)"></i> <%= settings.masjid_alamat.substring(0, 35) %>...</a>
          <a href="tel:<%= settings.masjid_telepon %>"><i class="fas fa-phone" style="color:var(--gold-accent)"></i> <%= settings.masjid_telepon %></a>
          <a href="mailto:<%= settings.masjid_email %>"><i class="fas fa-envelope" style="color:var(--gold-accent)"></i> <%= settings.masjid_email %></a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Tentang</h4>
        <p style="color:rgba(255,255,255,0.7);font-size:0.88rem;line-height:1.75"><%= settings.masjid_deskripsi %></p>
      </div>
    </div>

    <div class="footer-bottom">
      <p><%= settings.footer_copyright %></p>
      <p style="color:rgba(255,255,255,0.6)">Kemewahan Ibadah &bull; Berkhidmat Untuk Umat</p>
    </div>
  </div>
</footer>

<!-- BACK TO TOP -->
<button class="back-to-top" id="back-to-top" aria-label="Kembali ke atas">
  <i class="fas fa-chevron-up"></i>
</button>

<script src="/js/main.js"></script>
</body>
</html>
