<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= artikel.ringkasan %>">
  <meta name="keywords" content="<%= artikel.kategori %>, masjid, islam, <%= settings.masjid_nama %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= artikel.ringkasan %>">
  <meta property="og:image" content="<%= artikel.gambar %>">
  <meta property="og:type" content="article">
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    .article-header { padding: 120px 0 40px; background: linear-gradient(135deg, rgba(26,92,56,0.05), rgba(45,122,79,0.1)); text-align: center; }
    .article-title { font-size: 2.5rem; color: var(--primary-dark); margin-bottom: 1rem; max-width: 800px; margin-left: auto; margin-right: auto; line-height: 1.3; }
    .article-meta { display: flex; align-items: center; justify-content: center; gap: 1.5rem; color: var(--text-muted); font-size: 0.95rem; margin-bottom: 2rem; }
    .article-meta-item { display: flex; align-items: center; gap: 0.5rem; }
    .article-img-wrap { max-width: 900px; margin: 0 auto -60px; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.1); position: relative; z-index: 2; }
    .article-img-wrap img { width: 100%; height: auto; display: block; aspect-ratio: 16/9; object-fit: cover; }
    .article-body { max-width: 800px; margin: 100px auto 60px; padding: 0 20px; font-size: 1.1rem; line-height: 1.8; color: var(--text); }
    .article-body p { margin-bottom: 1.5rem; }
    .article-body img { max-width: 100%; border-radius: 12px; margin: 2rem 0; }
    .article-body h2, .article-body h3 { color: var(--primary-dark); margin: 2.5rem 0 1rem; }
    .related-articles { background: #f8faf9; padding: 60px 0; }
  </style>
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar" style="background: rgba(255, 255, 255, 0.95); box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
  <div class="nav-container">
    <a href="/" class="nav-brand">
      <% if (settings.masjid_logo && settings.masjid_logo !== '/images/logo-masjid.png') { %>
        <img src="<%= settings.masjid_logo %>" alt="Logo <%= settings.masjid_nama %>" class="nav-logo">
      <% } else { %>
        <div style="width:48px;height:48px;background:linear-gradient(135deg,#1a5c38,#2d7a4f);border-radius:12px;display:flex;align-items:center;justify-content:center;color:white;font-size:1.5rem;">🕌</div>
      <% } %>
      <div class="nav-brand-text">
        <div class="brand-label">Masjid</div>
        <div class="brand-name"><%= settings.masjid_nama %></div>
        <div class="brand-tagline"><%= settings.masjid_slogan %></div>
      </div>
    </a>

    <ul class="nav-menu" id="nav-menu">
      <% navMenu.forEach(menu => { %>
        <li><a href="<%= menu.url.startsWith('#') ? '/' + menu.url : menu.url %>"><%= menu.label %></a></li>
      <% }) %>
      <li>
        <a href="/#donasi" class="btn-donasi">
          <i class="fas fa-hand-holding-heart"></i>
          Donasi Sekarang
        </a>
      </li>
    </ul>

    <button class="nav-mobile-btn" id="nav-mobile-btn" aria-label="Menu">
      <span class="hamburger-icon" style="font-size:1.5rem;color:var(--primary)">☰</span>
    </button>
  </div>
</nav>

<!-- HEADER -->
<header class="article-header">
  <div class="section-container">
    <span class="badge badge-primary" style="margin-bottom: 1rem;"><%= artikel.kategori %></span>
    <h1 class="article-title"><%= artikel.judul %></h1>
    <div class="article-meta">
      <div class="article-meta-item"><i class="fas fa-calendar-alt"></i> <%= artikel.created_at.split(' ')[0] %></div>
      <div class="article-meta-item"><i class="fas fa-user-edit"></i> <%= artikel.penulis || 'Admin' %></div>
    </div>
  </div>
</header>

<!-- FEATURED IMAGE -->
<% if (artikel.gambar) { %>
<div class="section-container">
  <div class="article-img-wrap fade-in">
    <img src="<%= artikel.gambar %>" alt="<%= artikel.judul %>">
  </div>
</div>
<% } %>

<!-- CONTENT -->
<article class="article-body">
  <%- artikel.konten %>
  
  <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between;">
    <div>
      <span style="font-weight: 600; color: var(--text-dark); margin-right: 1rem;">Bagikan:</span>
      <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(title + ' - ' + settings.masjid_nama) %>" target="_blank" class="sosmed-btn" style="background:#25d366;color:white"><i class="fab fa-whatsapp"></i></a>
      <a href="https://www.facebook.com/sharer/sharer.php?u=#" target="_blank" class="sosmed-btn fb" style="color:white"><i class="fab fa-facebook-f"></i></a>
    </div>
    <a href="/#artikel" class="btn btn-secondary">
      <i class="fas fa-arrow-left"></i> Kembali ke Beranda
    </a>
  </div>
</article>

<!-- RELATED ARTICLES -->
<% if (artikelTerkait && artikelTerkait.length > 0) { %>
<section class="related-articles">
  <div class="section-container">
    <div class="section-header text-center">
      <h2 class="section-title">Artikel <span class="text-primary">Terkait</span></h2>
    </div>
    <div class="grid-3">
      <% artikelTerkait.forEach(a => { %>
        <div class="card artikel-card fade-in">
          <a href="/artikel/<%= a.slug %>" class="artikel-img-wrap">
            <img src="<%= a.gambar || '/images/artikel-placeholder.jpg' %>" alt="<%= a.judul %>" class="artikel-img">
            <span class="artikel-kategori"><%= a.kategori %></span>
          </a>
          <div class="artikel-content">
            <div class="artikel-meta">
              <span><i class="fas fa-calendar-alt"></i> <%= a.created_at.split(' ')[0] %></span>
            </div>
            <h3 class="artikel-title"><a href="/artikel/<%= a.slug %>"><%= a.judul %></a></h3>
            <p class="artikel-desc"><%= a.ringkasan %></p>
            <a href="/artikel/<%= a.slug %>" class="artikel-read-more">Baca Selengkapnya <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- FOOTER -->
<footer class="footer">
  <div class="section-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="nav-brand" style="margin-bottom:1rem">
          <div style="width:40px;height:40px;background:linear-gradient(135deg,#2d7a4f,#1a5c38);border-radius:10px;display:flex;align-items:center;justify-content:center;color:white;font-size:1.25rem">🕌</div>
          <div class="nav-brand-text">
            <div class="brand-label">Masjid</div>
            <div class="brand-name"><%= settings.masjid_nama %></div>
            <div class="brand-tagline"><%= settings.masjid_slogan %></div>
          </div>
        </div>
        <p class="footer-desc"><%= settings.footer_deskripsi %></p>
        <div class="sosmed-links">
          <% if (settings.sosmed_facebook) { %>
            <a href="<%= settings.sosmed_facebook %>" target="_blank" class="sosmed-btn fb" style="padding:8px 10px"><i class="fab fa-facebook-f"></i></a>
          <% } %>
          <% if (settings.sosmed_instagram) { %>
            <a href="<%= settings.sosmed_instagram %>" target="_blank" class="sosmed-btn ig" style="padding:8px 10px"><i class="fab fa-instagram"></i></a>
          <% } %>
          <% if (settings.sosmed_youtube) { %>
            <a href="<%= settings.sosmed_youtube %>" target="_blank" class="sosmed-btn yt" style="padding:8px 10px"><i class="fab fa-youtube"></i></a>
          <% } %>
        </div>
      </div>

      <div class="footer-col">
        <h4>Navigasi</h4>
        <div class="footer-links">
          <% navMenu.slice(0, 6).forEach(menu => { %>
            <a href="<%= menu.url.startsWith('#') ? '/' + menu.url : menu.url %>"><i class="fas fa-chevron-right" style="font-size:0.6rem"></i> <%= menu.label %></a>
          <% }) %>
        </div>
      </div>

      <div class="footer-col">
        <h4>Kontak</h4>
        <div class="footer-links">
          <a href="#"><i class="fas fa-map-marker-alt"></i> <%= settings.masjid_alamat.substring(0, 40) %>...</a>
          <a href="tel:<%= settings.masjid_telepon %>"><i class="fas fa-phone"></i> <%= settings.masjid_telepon %></a>
          <a href="mailto:<%= settings.masjid_email %>"><i class="fas fa-envelope"></i> <%= settings.masjid_email %></a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Tentang</h4>
        <p style="color:var(--gray-400);font-size:0.9rem;line-height:1.6"><%= settings.masjid_deskripsi %></p>
      </div>
    </div>

    <div class="footer-bottom">
      <p><%= settings.footer_copyright %></p>
      <p>Dibangun dengan ❤️ untuk umat</p>
    </div>
  </div>
</footer>

<!-- BACK TO TOP -->
<button class="back-to-top" id="back-to-top" aria-label="Kembali ke atas">
  <i class="fas fa-chevron-up"></i>
</button>

<script src="/js/main.js"></script>
</body>
</html>
